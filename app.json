{
  "expo": {
    "name": "OreGuide",
    "slug": "OreGuide",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/ore_guide app_icon.png",
    "scheme": "oreguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/ore_guide app_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.OreGuide",
      "enableProguardOptimizations": false,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "adjustResize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/intro.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5c593da-5c0e-42d3-bc63-9e3446475258"
      }
    },
    "owner": "pixelpebble"
  }
}
